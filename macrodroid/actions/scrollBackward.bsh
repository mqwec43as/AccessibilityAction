import android.view.accessibility.AccessibilityNodeInfo;
import bsh.This;

/*───────────────────────────────────────────────────────────────
 * scrollBackward(String key, String value, int index)
 * **Scroll Backward**
 * Scrolls the scrollable container **backward** (e.g., up/left).
 * If no parameters, scrolls the first scrollable container on the screen.
 *
 * Arguments:
 * * - key → Target node selector type.
 * * - value → Target node identifier.
 * * - index → Node index (0 for first match).
 *
 * Example (Screen-wide):
 * scrollBackward();
 * ───────────────────────────────────────────────────────────────*/
scrollBackward(AccessibilityNodeInfo node) {
	if (node == null) return null;
	if (!node.isScrollable()) node = getScrollableParent(node);
	boolean success;
	if (node != null) success = node.performAction(AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD);
	if (success) {
        node.refresh();
        stepDelay();
	    return node;
    } else {
        return null;
    }
}

scrollBackward(This multiKeys) {
	return scrollBackward(getNode(multiKeys));
}

scrollBackward(String key, String value, int index) {
	AccessibilityNodeInfo node = getNode(key, value, index);
	return scrollBackward(node);
}

scrollBackward(int scrollCount, int areaOrderIndex) {
	List scrollableNodes = findScrollNodes();
    
	if (!hasNode(scrollableNodes)) {
		log("No scrollable node found on screen.");
		return null;
	} else {
        AccessibilityNodeInfo node = toNode(scrollableNodes, areaOrderIndex);
        boolean hasSuccess;

        for (int i = 0; i < scrollCount; i++) {
			node.refresh();
           	boolean success = node.performAction(AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD);
            if (!success) {
				log("Failed to scroll backward at." + i + "th of " + scrollCount + " times.");
                break;
            } else {
                if (!hasSuccess) hasSuccess = true;
				if (A11yConfig.stepDelay <= 50) {
					wait(50);
				} else {
					stepDelay();
				}
            }
        }

        if (hasSuccess) {
            return node;
        } else {
            return null;
        }
    }
}

scrollBackward(int scrollCount) {
	return scrollBackward(scrollCount, 0);
}

scrollBackward() {
	return scrollBackward(1, 0);
}
