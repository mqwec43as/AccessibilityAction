import bsh.This;

/*────────────────────────────────────────────────────────────────
gesture(Object[][] points, Paint paint)
Dispatches a multi-step gesture trail using modern accessibility metrics,
safely adapting to target displays if defined in A11yConfig.displayId.

Arguments:

* points → Multidimensional array containing steps [X, Y, actionType, duration, (optional control points)]
* paint → Optional Paint styling instance to handle visual trail overlays

Returns:

* boolean → True if gesture execution finishes successfully, false otherwise.
──────────────────────────────────────────────────────────────── */
public boolean gesture(Object[][] points, Paint paint) {
    if (points == null || points.length == 0) return false;

    AccessibilityNodeInfo rootNode = getRoot();
    if (rootNode == null) {
        return gestureShizuku(points, paint);
    }

    Context windowContext = getContext(true);
    int targetDisplayId = windowContext.getDisplay().getDisplayId();

    WindowManager windowManager = (WindowManager) windowContext.getSystemService(Context.WINDOW_SERVICE);
    DisplayMetrics displayMetrics = getDisplayMetrics(targetDisplayId);
    int screenWidth = displayMetrics.widthPixels;
    int screenHeight = displayMetrics.heightPixels;

    Bitmap trailBitmap = Bitmap.createBitmap(screenWidth, screenHeight, Bitmap.Config.ARGB_8888);
    Canvas trailCanvas = new Canvas(trailBitmap);
    boolean showTrail = (paint != null);

    Handler mainThreadHandler = new Handler(Looper.getMainLooper());
    ImageView overlayImageView;

    This uiInitSignal = CompletableImpl();
    if (showTrail) {
        mainThreadHandler.post(new Runnable() {
            run() {
                overlayImageView = new ImageView(windowContext);
                overlayImageView.setImageBitmap(trailBitmap);
                uiInitSignal.onComplete();
            }
        });
        uiInitSignal.blockingAwait(1000, TimeUnit.MILLISECONDS);
    }


    WindowManager.LayoutParams windowParams = new WindowManager.LayoutParams(
        WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
        WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
        66088,
        PixelFormat.TRANSLUCENT
    );
    windowParams.layoutInDisplayCutoutMode = 1;
    windowParams.gravity = Gravity.TOP | Gravity.LEFT;

    try {
        HandlerThread handlerThread = new HandlerThread("A11yThread" + System.currentTimeMillis());
        handlerThread.start();
        Handler accessibilityHandler = new Handler(handlerThread.getLooper());

        StrokeDescription currentStroke = null;
        boolean strokeStarted = false;
        float lastX = 0f;
        float lastY = 0f;

        for (int pointIndex = 0; pointIndex < points.length; pointIndex++) {
            float targetX = points[pointIndex][0];
            float targetY = points[pointIndex][1];
            if (Math.abs(targetX) <= 1.0f) targetX *= (float) screenWidth;
            if (Math.abs(targetY) <= 1.0f) targetY *= (float) screenHeight;

            int actionType = points[pointIndex][2];
            long totalDuration = points[pointIndex][3];

            int totalSteps = (actionType == 3 || actionType == 4) ? (int) Math.max(1, totalDuration / 16) : 1;
            long stepDuration = Math.max(1, totalDuration / totalSteps);

            for (int stepIndex = 1; stepIndex <= totalSteps; stepIndex++) {
                float progressRatio = (float) stepIndex / totalSteps;
                float currentStepX, currentStepY;

                if (actionType == 3 && points[pointIndex].length >= 6) {
                    float controlX1 = points[pointIndex][4];
                    float controlY1 = points[pointIndex][5];
                    if (Math.abs(controlX1) <= 1.0f) {
                        controlX1 *= screenWidth;
                        controlY1 *= screenHeight;
                    }
                    float inverseProgress = 1 - progressRatio;
                    currentStepX = inverseProgress * inverseProgress * lastX + 2 * inverseProgress * progressRatio * controlX1 + progressRatio * progressRatio * targetX;
                    currentStepY = inverseProgress * inverseProgress * lastY + 2 * inverseProgress * progressRatio * controlY1 + progressRatio * progressRatio * targetY;
                }
                else {
                    currentStepX = targetX;
                    currentStepY = targetY;
                }

                Path strokePath = new Path();
                if (!strokeStarted) {
                    if (showTrail) {
                        mainThreadHandler.post(new Runnable() {
                            run() { try { windowManager.addView(overlayImageView, windowParams); } catch (Exception ignoredException) {} }
                        });
                    }
                    strokePath.moveTo(currentStepX, currentStepY);
                    strokePath.lineTo(currentStepX, currentStepY);
                    currentStroke = new StrokeDescription(strokePath, 0, stepDuration, true);
                    strokeStarted = true;
                } else {
                    strokePath.moveTo(lastX, lastY);
                    strokePath.lineTo(currentStepX, currentStepY);
                    boolean isLastStep = (pointIndex == points.length - 1 && stepIndex == totalSteps);
                    boolean willContinue = (!isLastStep && actionType != 2);
                    currentStroke = currentStroke.continueStroke(strokePath, 0, stepDuration, willContinue);
                }

                final Path drawPath = strokePath;

                AccessibilityService.GestureResultCallback gestureCallback;


                GestureDescription.Builder gestureBuilder = new GestureDescription.Builder();
                gestureBuilder.addStroke(currentStroke);
                gestureBuilder.setDisplayId(targetDisplayId);
                getService().dispatchGesture(gestureBuilder.build(), gestureCallback, accessibilityHandler);


                lastX = currentStepX;
                lastY = currentStepY;
            }
        }

        if (showTrail) {
            mainThreadHandler.postDelayed(new Runnable() {
                run() {
                    try {
                        windowManager.removeView(overlayImageView);
                    } catch (Exception ignoredException) {

                    }
                }
            }, 200);
        }
        handlerThread.quitSafely();
        return true;
    } catch (Exception executionException) {
        if (showTrail) mainThreadHandler.post(new Runnable() {
            run() {
                try {
                    windowManager.removeView(overlayImageView);
                } catch (Exception ignoredException) {}
            }
        });
        log("Gesture failed: " + executionException.getMessage(), "ERROR", super);
        return false;
    }

}

public boolean gesture(Object[][] points) {
    return gesture(points, null);
}

