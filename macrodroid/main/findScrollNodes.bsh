/* ───────────────────────────────────────────────────────────────
 * Finds all scrollable nodes matching a selector ("id", "text", "regex", "focus").
 *
 * Arguments:
 * * - root → The starting node for the search.
 * * - key → Selector type ("id", "text", etc.)
 * * - value → Selector value.
 *
 * Example:
 * List buttons = findScrollNodes(getRoot(), "text", "Save");
 * ───────────────────────────────────────────────────────────────*/
List findScrollNodes(List nodes) {
	List scrollableNodes = new ArrayList();

	for (AccessibilityNodeInfo node: nodes) {
		AccessibilityNodeInfo found;
		if (node.isScrollable()) {
			found = node;
		} else {
			AccessibilityNodeInfo parent = getScrollableParent(node);
			if (parent != null) found = parent;
		}

		if (found != null && !scrollableNodes.contains(found)) scrollableNodes.add(found);

		if (A11yConfig.findFirstForRecursive && !scrollableNodes.isEmpty()) break;
	}

	if (scrollableNodes.isEmpty()) {
		scrollableNodes = sortByArea(nodes);
		debugMe(scrollableNodes);
	}
	
	return scrollableNodes;
}

List findScrollNodes(AccessibilityNodeInfo root, String key, String value) {
	List nodes = findNodes(root, key, value);
	return findScrollNodes(nodes);
}

List findScrollNodes(String key, String value) {
	List nodes = findNodes(key, value);
	return findScrollNodes(nodes);
}

List findScrollNodes(String text) {
	List nodes = findNodes(text);
	return findScrollNodes(nodes);
}

/* ───────────────────────────────────────────────────────────────
 * Finds multiple sets of scrollable nodes simultaneously and maps them to custom IDs.

 * Arguments:
	* root → The starting node for the search.
	* argsConfigs → Array of configurations: { "id", "key", "value", [proximity] }.
	* allFound → Until all configurations are found or not.

 * Returns:
	* HashMap: keys are the provided IDs, values are ArrayLists of nodes.
	* Returns an empty HashMap if no matches are found.
───────────────────────────────────────────────────────────────*/
findScrollNodes(AccessibilityNodeInfo root, Object[][] argsConfigs, boolean allFound) {
	Map nodes = findNodes(root, argsConfigs, allFound);
	Iterator iterator = nodes.keySet().iterator();
	Map scrollableNodes = new HashMap();
	while (iterator.hasNext()) {
		String key = (String) iterator.next();
		List nodesList = (List) nodes.get(key);
		List scrollableNodesList = findScrollNodes(nodesList);
		if (!scrollableNodesList.isEmpty()) scrollableNodes.put(key, scrollableNodesList);
	}
	return scrollableNodes;
}

findScrollNodes(Object[][] argsConfigs, boolean allFound) {
	Map nodes = findNodes(argsConfigs, allFound);
	Iterator iterator = nodes.keySet().iterator();
	Map scrollableNodes = new HashMap();
	while (iterator.hasNext()) {
		String key = (String) iterator.next();
		List nodesList = (List) nodes.get(key);
		List scrollableNodesList = findScrollNodes(nodesList);
		if (!scrollableNodesList.isEmpty()) scrollableNodes.put(key, scrollableNodesList);
	}
	return nodes;
}

