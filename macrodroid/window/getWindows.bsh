import android.util.SparseArray;
import java.util.Iterator;
import java.util.regex.Pattern;
import android.view.accessibility.AccessibilityWindowInfo;

/* ───────────────────────────────────────────────────────────────
 * Get all windows for a display
 *
 * Returns:
 * - List of AccessibilityWindowInfo
 ────────────────────────────────────────────────────────────── */
List getWindows(int displayId) {
	SparseArray allDisplaysWindows = getService().getWindowsOnAllDisplays();
    List windows = new ArrayList();
	if (allDisplaysWindows == null) {
		return windows;
	}
	
	if (WindowInfo == void) WindowInfo = WindowInfo();
	
	int typeFlag = A11yConfig == void ? WindowInfo.TYPE_NONE : A11yConfig.filterWindowType;
	Pattern filterPackageNamePattern = filterWindowPackageName == void ? null : Pattern.compile(filterWindowPackageName);

	List displayWindows = allDisplaysWindows.get(displayId);
	if (displayWindows != null) {
		if (typeFlag != WindowInfo.TYPE_NONE) {
			for(AccessibilityWindowInfo window: displayWindows) {
				if (A11yConfig.IsWindowMatchFilter(window)) {
					windows.add(window);
				}				
			}
		} else {
        	windows.addAll(displayWindows);
		}
    }
    
	return windows;
}

List getWindows() {
	int displayId = A11yConfig == void ? 0 : A11yConfig.displayId;
	return getWindows(displayId);
}