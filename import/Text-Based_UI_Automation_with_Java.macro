llFromNodeTo(key, value, toKey, toValue, scrollCount, scrollForward);\r\n} catch(e) {}\r\n\r\nreturn node !\u003d null;","disableLogging":false,"m_SIGUID":-7009387231657800157,"m_classType":"JavaAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Text-Based UI Interaction","m_completed":true,"m_constraintList":[],"m_description":"Use Java code to scroll until text / view ID is found.  This macro doesn\u0027t involve gesture and only works against screens that have proper scrollable views. E.g standard android app.\r\n\r\nRequires another macro called Text-Based UI Automation with Java\r\n https://www.macrodroidlink.com/macrostore?id\u003d31105","m_descriptionOpen":false,"m_enabled":false,"m_excludeLog":false,"m_headingColor":-16611119,"m_isOrCondition":false,"m_name":"Scroll to Text / View id","m_triggerList":[]}],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1790645121161,"localVariableSeparators":[],"localVariables":[{"description":"Automatically set when importing or can be set to the directory where a11Y.java exists.\n\nSay this is the path of a11Y.java\n/storage/emulated/0/UI/a11Y.java\n\nThe path here should be \n/storage/emulated/0/UI","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":true,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"projectPath","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true}],"localVarsAlphabetical":false,"loggingLevel":0,"m_GUID":-5484661419444350946,"m_actionList":[{"childrenCollapsed":true,"dontLogIfConditionIsFalse":false,"disableLogging":false,"m_SIGUID":-5388016578214841129,"m_classType":"IfConditionAction","m_comment":"","m_constraintList":[{"m_not":false,"m_siGuidThatInvoked":-5942601821977335104,"m_triggerName":"Empty Trigger","disableLogging":fa