importCommands("lib.ui");
importCommands("assist.button");

import android.content.Context;
import android.graphics.Color;
import android.graphics.PixelFormat;
import android.graphics.drawable.Drawable;
import android.graphics.drawable.GradientDrawable;
import android.os.Handler;
import android.os.Looper;
import android.util.DisplayMetrics;
import android.util.TypedValue;
import android.view.ContextThemeWrapper;
import android.view.GestureDetector;
import android.view.Gravity;
import android.view.MotionEvent;
import android.view.View;
import android.view.ViewGroup;
import android.view.WindowManager;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.view.Display;

import com.google.android.material.button.MaterialButton;
import com.joaomgcd.taskerm.action.java.JavaCodeException;
import android.accessibilityservice.AccessibilityService;
import android.view.accessibility.AccessibilityWindowInfo;

import java.util.ArrayList;
import java.util.List;
import android.view.HapticFeedbackConstants;

import bsh.This;

/*───────────────────────────────────────────────────────────────
  dp(int value)
  ───────────────────────────────────────────────────────────────*/
public int dp(int value) {
	return (int) TypedValue.applyDimension(
		TypedValue.COMPLEX_UNIT_DIP,
		value,
		context.getResources().getDisplayMetrics()
	);
}

/*───────────────────────────────────────────────────────────────
	AssistBar(int initialX, int initialY)
  ───────────────────────────────────────────────────────────────*/
public This AssistBar(int initialX, int initialY) {

	final int CAPTURE_MODE = 1;
	final int DELETE_CAPTURE_MODE = 2;

	final int ACTIVITY_NONE = 0;
	final int CAPTURING_STRUCTURE = 1;
	final int STRUCTURE_CAPTURED = 2;
	final int OPENING_FILTER = 3;
	final int OPENING_SETTINGS = 4;
	final int OPENING_SCRIPT_EDITOR = 5;
	final int OPENING_NODE_SEARCH = 6;
	final int OPENING_ACTIONS_GROUP = 7;

	int state = ACTIVITY_NONE;
	int mode = CAPTURE_MODE;

	This AssistInfo = AssistInfo();
	final This TOP = this;
	This a11Y = getA11yInstance();
	final int WINDOW_TYPE = ENV.Layout.TYPE_ASSIST_BAR;
	a11Y.viewControl.addView(TOP);

	if (ENV == void || ENV == null) ENV = Environment();
	ENV.checkMaterialLib(this);

	// Properties
	boolean useA11y = true;
	This tm;
	int padding = dp(4);
	Context assistContext;
	WindowManager windowManager;
	int assistOverlayType = useA11y ?
		WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY :
		WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY;
	FrameLayout assistBar;
	WindowManager.LayoutParams assistParams;
	int screenheight;
	DisplayMetrics displayMetrics;
	LinearLayout container;
	Handler mainHandler = new Handler(Looper.getMainLooper());
	boolean isRemoved;
	boolean isShowing;
	boolean hasShownOnce;
	int selectedDisplayId;
	int selectedWindowFilter;

	// Instances
	This structureOverlay;
	This filterSheet;
	This nodeSearch;
	This displayMenu;
	This windowMenu;
	This scriptEditor;
	This assistSetting;
	This actionPicker;
	This actionsGroupDialog;

	// Buttons and Handle
	GestureDetector detector;
	Map buttons = new HashMap();
	float initialTouchX;
	float initialTouchY;
	int initialWinX;
	int initialWinY;
	This handleGesture;

	create() {
		assistContext = getContext(useA11y);
		windowManager = (WindowManager) assistContext.getSystemService(Context.WINDOW_SERVICE);

		/* THEME */
		tm = ThemeManager(assistContext);
		tm.setThemeDark();

		displayMetrics = getDisplayMetrics();
		screenheight = displayMetrics.heightPixels;

		/* ROOT & CONTAINER SETUP */
		assistBar = new FrameLayout(assistContext);
		container = new LinearLayout(assistContext);
		container.setOrientation(LinearLayout.HORIZONTAL);

		GradientDrawable bg = new GradientDrawable();
		bg.setShape(GradientDrawable.RECTANGLE);
		bg.setCornerRadius(dp(28));
		bg.setColor(tm.color("colorSurfaceContainerHighest"));
		container.setBackground(bg);
		container.setPadding(padding, padding, padding, padding);

		FrameLayout.LayoutParams containerParams = new FrameLayout.LayoutParams(-2, -2);
		container.setLayoutParams(containerParams);
		assistBar.addView(container);

		container.setOnHierarchyChangeListener(new ViewGroup.OnHierarchyChangeListener() {
			public void onChildViewAdded(View parent, View child) {

			}

			public void onChildViewRemoved(View parent, View child) {
				// This code runs when a view is removed
			}
		});

		assistParams = new WindowManager.LayoutParams(
			WindowManager.LayoutParams.WRAP_CONTENT,
			WindowManager.LayoutParams.WRAP_CONTENT,
			assistOverlayType,
			WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE |
			WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN |
			WindowManager.LayoutParams.FLAG_LAYOUT_INSET_DECOR,
			PixelFormat.TRANSLUCENT
		);
		assistParams.gravity = Gravity.TOP | Gravity.LEFT;
		assistParams.x = initialX;
		assistParams.y = initialY;
	}

	setHandleTouch(boolean state) {
		This handleBtn = getIconButton(AssistInfo.HANDLE_BUTTON);
		if (state) {
			handleGesture.unmute();
		} else {
			handleGesture.mute();
		}
		handleBtn.setTouchState(state);
	}

	setHandleMode(int mode, boolean state) {
		This handleBtn = getIconButton(AssistInfo.HANDLE_BUTTON);
		if (state) {
			handleGesture.unmute();
		} else {
			handleGesture.mute();
		}
		switch (mode) {
			case CAPTURE_MODE:
				super.mode = CAPTURE_MODE;
				handleBtn.resetIcon();
				handleBtn.setTouchState(state);
				break;
			case DELETE_CAPTURE_MODE:
				super.mode = DELETE_CAPTURE_MODE;
				handleBtn.setTemporaryIcon(AssistInfo.DELETE_ICON);
				handleBtn.setTouchState(state);
				if (state) {
					handleBtn.setTemporaryIconColor(tm.color("colorErrorContainer"), tm.color("colorOnErrorContainer"));
				}
				break;
		}
	}


	/*────────────────────────────
	  UTILITY METHODS
	────────────────────────────*/
	getContext() {
		return assistContext;
	}

	removeStructure() {
		This searchBtn = getIconButton(AssistInfo.SEARCH_BUTTON);
		searchBtn.setTouchState(false);
		if (structureOverlay != null && !structureOverlay.isRemoved()) {
			structureOverlay.remove();
		}
	}

	ensureLayout(View v) {
		if (v.getLayoutParams() == null) {
			v.setLayoutParams(new LinearLayout.LayoutParams(-2, -1));
		}
	}

	refreshSize() {
		int oldWidth = assistParams.width;
		container.measure(
			View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
			View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
		);
		int measuredHeight = container.getMeasuredHeight();
		int measuredWidth = container.getMeasuredWidth();

		if (oldWidth > 0 && measuredWidth != oldWidth) {
			assistParams.x = assistParams.x - (measuredWidth - oldWidth);
		}

		assistParams.height = measuredHeight;
		assistParams.width = measuredWidth;

		if (!isShowing()) return;
		try {
			windowManager.updateViewLayout(assistBar, (WindowManager.LayoutParams) assistParams);
		} catch (e) {}
	}

	addButton(String name, Drawable drawable, boolean isActive, boolean displayFirst, View.OnClickListener onClickListener) {
		This iconButton = IconButton(TOP);
		iconButton.setId(name);
		MaterialButton button = iconButton.build();
		iconButton.setIcon(drawable);
		iconButton.setColorState(isActive);
		iconButton.addToContainer();
		if (!displayFirst) {
			iconButton.removeFromContainer();
		}
		if (onClickListener != null) {
			button.setOnClickListener(onClickListener);
		}
		return button;
	}

	getIconButton(String id) {
		return buttons.get(id);
	}

	getButton(String id) {
		This iconButton = buttons.get(id);
		if (iconButton == null) {
			throw new NullPointerException("No button with id " + id);
		}
		return iconButton.button;
	}

	addButtons() {
		// Var name, icon, isActive, display at first, onClick
		Object[][] buttonsConfig = new Object[][] {
			{
				AssistInfo.HANDLE_BUTTON,
					tm.attr(AssistInfo.HANDLE_ICON),
					true,
					true,
					null
			},
			{
				AssistInfo.ACTIONS_GROUP_BUTTON,
				tm.attr(AssistInfo.ACTIONS_GROUP_ICON),
				false,
				true,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						toggleActionsGroup();
					}
				}
			},
			{
				AssistInfo.SCRIPT_BUTTON,
				tm.attr(AssistInfo.SCRIPT_ICON),
				false,
				true,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						toggleScriptEditor();
					}
				}
			},
			{
				AssistInfo.SETTING_BUTTON,
				tm.attr(AssistInfo.SETTING_ICON),
				false,
				true,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						toggleSetting();
					}
				}
			},
			{
				AssistInfo.FILTER_BUTTON,
				tm.attr(AssistInfo.FILTER_ICON),
				false,
				false,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						toggleFilter();
					}
				}
			},
			{
				AssistInfo.SEARCH_BUTTON,
				tm.attr(AssistInfo.SEARCH_ICON),
				false,
				false,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						toggleSearch();
					}
				}
			},
			{
				AssistInfo.CLOSE_BUTTON,
				tm.attr(AssistInfo.CLOSE_ICON),
				false,
				true,
				new View.OnClickListener() {
					onClick(View view) {
						view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
						remove();
					}
				}
			}
		};

		for (Object[] button: buttonsConfig) {
			String name = button[0];
			Drawable drawable = button[1];
			boolean isActive = button[2];
			boolean displayFirst = button[3];
			View.OnClickListener onClickListener = button[4];
			MaterialButton button = addButton(name, drawable, isActive, displayFirst, onClickListener);
		}

		This closeIcon = getIconButton(AssistInfo.CLOSE_BUTTON);
		closeIcon.setIconColor(tm.color("colorErrorContainer"), tm.color("colorOnErrorContainer"));

		return;
	}

	isDialogsShowing() {
		return a11Y.viewControl.isAnyVisible(ENV.Layout.TYPE_ALL_WINDOWS);
	}

	removeDialogs() {
		a11Y.viewControl.remove(ENV.Layout.TYPE_ALL_WINDOWS);
	}

	/*────────────────────────────
	  Search Utils
	────────────────────────────*/
	showSearch() {
		if (filterSheet != null) filterSheet.remove();
		nodeSearch = NodeSearch(structureOverlay);
		A11yConfig.refresh();
		a11Y.viewControl.show(ENV.Layout.TYPE_NODE_SEARCH);
		super.state = OPENING_NODE_SEARCH;
	}

	toggleSearch() {
		Runnable runMe = new Runnable() {
			run() {
				try {
					if (nodeSearch != null) {
						if (structureOverlay != null && structureOverlay.isShowing()) {
							showSearch();
						} else {
							nodeSearch.remove();
							nodeSearch = null;
							structureOverlay.unhide();
						}
					} else {
						showSearch();
					}
				} catch (e) {
					tasker.showToast(e.getMessage());
				}
			}
		};
		runMe(runMe);
	}

	toggleScriptEditor() {
		a11Y.viewControl.show(ENV.Layout.TYPE_SCRIPT_EDITOR);
		super.state = OPENING_SCRIPT_EDITOR;
	}

	toggleSetting() {
		a11Y.viewControl.toggle(ENV.Layout.TYPE_SETTINGS);
		super.state = OPENING_SETTINGS;
	}

	toggleFilter() {
		if (filterSheet == null) {
			filterSheet = FilterSheet(TOP.namespace.getVariable("structureOverlay"));
			int filterY = (1 - filterSheet.config.maxHeight) * screenheight;
			int assistY = assistParams.y + assistParams.height;
			if (assistY > filterY) moveHandle(assistParams.x, filterY - assistParams.height);
		}
		structureOverlay.unhide();
		if (filterSheet != null) filterSheet.toggle();
		if (nodeSearch != null) nodeSearch.remove();
		super.state = OPENING_FILTER;
	}

	toggleActionsGroup() {
		removeStructure();
		a11Y.viewControl.toggle(ENV.Layout.TYPE_ACTIONS_GROUP_DIALOGS);
		super.state = OPENING_ACTIONS_GROUP;
	}

	isSystemWindow() {
		AccessibilityWindowInfo focusedWindow = getFocusedWindow(selectedDisplayId);
		if (focusedWindow == null) return false;
		return focusedWindow.type == AccessibilityWindowInfo.TYPE_SYSTEM;
	}

	displayStructure(AccessibilityWindowInfo window) {
		setHandleMode(CAPTURE_MODE, false);
		super.state = CAPTURING_STRUCTURE;
		if (window == null) {
			setHandleMode(CAPTURE_MODE, true);
			removeStructure();
			super.state = ACTIVITY_NONE;
			throw new NullPointerException("Window is null");
			return;
		}
		Runnable displayMe = new Runnable() {
			run() {
				try {
					log("Displaying Structure Overlay for display " + window, "INFO", TOP);
					removeStructure();
					boolean useA11yStructure = true;
					if (useA11yStructure) remove();
					This listener = createStructureOverlayListener();
					structureOverlay = StructureOverlay(listener, useA11yStructure, window);
					structureOverlay.show();
					if (useA11yStructure) show();
				} catch (e) {
					activity = ACTIVITY_NONE;
					removeStructure();
					setHandleMode(CAPTURE_MODE, true);
					log(e.getMessage(), "ERROR", TOP);
					tasker.showToast("Failed to display structure overlay");
					throw new JavaCodeException(e.getMessage());
				}
			}
		};
		a11Y.post(displayMe);
	}

	isDisplayExist(int displayId) {
		Display[] displays = getContext().getSystemService(Context.DISPLAY_SERVICE).getDisplays();
		for (Display display: displays) {
			if (display.getDisplayId() == displayId) {
				return true;
			}
		}
		return false;
	}

	displayStructureOnDefaultDisplay() {
		selectedDisplayId = getContext().getDisplay().getDisplayId();
		AccessibilityWindowInfo focusedWindow = getFocusedWindow(selectedDisplayId);
		displayStructure(focusedWindow);
	}

	displayStructure(int displayId) {
		if (!isDisplayExist(displayId)) {
			displayStructureOnDefaultDisplay();
			return;
		}
		Thread.sleep(100);
		AccessibilityWindowInfo focusedWindow = getFocusedWindow(displayId);
		displayStructure(focusedWindow);
	}

	displayStructure() {
		if (!isDisplayExist(selectedDisplayId)) {
			displayStructureOnDefaultDisplay();
			return;
		}
		Thread.sleep(100);
		AccessibilityWindowInfo focusedWindow = getFocusedWindow(selectedDisplayId);
		displayStructure(focusedWindow);
	}

	toggleStructure() {
		try {
			// Remove Any Dialogs
			if (isDialogsShowing()) {
				showToast("Press again after dialogs are closed");
				assistBar.performHapticFeedback(HapticFeedbackConstants.REJECT);
				removeDialogs();
				return;
			}

			if (structureOverlay == null) {
				log("Displaying Structure Overlay From Toggle because null", "INFO", this);
				displayStructure();
			}

			else if (structureOverlay.isShowing() || structureOverlay.isHidden() || mode == DELETE_CAPTURE_MODE) {
				structureOverlay.remove();
				log("Removing Structure Overlay From Toggle", "INFO", this);
			}

			else {
				log("Displaying Structure Overlay From Toggle" + structureOverlay.isRemoved(), "INFO", this);
				displayStructure();
			}

		} catch (e) {
			tasker.showToast(e.getMessage());
		}
	}

	toggleDisplayMenu() {
		Runnable runMe = new Runnable() {
			run() {
				a11Y.viewControl.toggle(ENV.Layout.TYPE_DISPLAY_MENU);
			}
		};
		a11Y.execute(runMe);
	}

	/*────────────────────────────
	  Layout Utils
	────────────────────────────*/
	public void replaceView(View currentView, View newView) {
		ViewGroup parent = (ViewGroup) currentView.getParent();
		if (parent == null) return;
		newView.setLayoutParams(currentView.getLayoutParams());
		final int index = parent.indexOfChild(currentView);
		parent.removeView(currentView);
		parent.addView(newView, index);
		refreshSize();
	}

	public void replaceButton(String currentButton, String newButton) {
		MaterialButton currentBtn = getButton(currentButton);
		MaterialButton newBtn = getButton(newButton);
		replaceView(currentBtn, newBtn);
	}

	public void switchLayout(boolean isStructureShown) {
		if (isStructureShown) {
			replaceButton(AssistInfo.SCRIPT_BUTTON, AssistInfo.SEARCH_BUTTON);
			replaceButton(AssistInfo.SETTING_BUTTON, AssistInfo.FILTER_BUTTON);
		} else {
			replaceButton(AssistInfo.SEARCH_BUTTON, AssistInfo.SCRIPT_BUTTON);
			replaceButton(AssistInfo.FILTER_BUTTON, AssistInfo.SETTING_BUTTON);
		}
	}

	// Listener for Structure Overlay to switch layout
	createStructureOverlayListener() {
		onViewAttachedToWindow(View view) {
			TOP.switchLayout(true);
			structureOverlay.takeScreenshot();
		}

		onViewDetachedFromWindow(View view) {
			setHandleMode(CAPTURE_MODE, true);
			This searchBtn = getIconButton(AssistInfo.SEARCH_BUTTON);
			searchBtn.setTouchState(false);
			log("Reset layout then remove structure overlay with node search & filter", TOP);
			TOP.switchLayout(false);
			try {
				filterSheet.remove();
				filterSheet = null;
				nodeSearch.remove();
				nodeSearch = null;
			} catch (e) {

			}
		}

		onStructureReady(This structureOverlay) {
			log("Switching layout to use structure overlay", TOP);
			super.state = STRUCTURE_CAPTURED;
		}

		onScreenshotSuccess(This screenshotHelper) {
			setHandleMode(DELETE_CAPTURE_MODE, false);
			This searchBtn = getIconButton(AssistInfo.SEARCH_BUTTON);
			searchBtn.setTouchState(true);
			if (structureOverlay.isShowing()) {
				setHandleMode(DELETE_CAPTURE_MODE, true);
				super.state = ACTIVITY_NONE;
			} else {
				setHandleMode(CAPTURE_MODE, true);
				screenshotHelper.recycle();
			}
		}

		return this;
	}

	/*────────────────────────────
	  Resources Control
	────────────────────────────*/
	setupResources() {
		if (displayMenu == null) {
			displayMenu = DisplayMenu();
			listener() {
				onClick(Object display) {
					TOP.namespace.setVariable("selectedDisplayId", display.getDisplayId(), false);
					showToast("Selected Display: " + display.getName());
					TOP.displayStructure(display.getDisplayId());
				}
				return this;
			}
			This listener = listener();
			displayMenu.setOnClickListener(listener);
		}
		if (windowMenu == null) {
			windowMenu = WindowMenu();
			listener() {
				onClick(AccessibilityWindowInfo window) {
					TOP.namespace.setVariable("selectedDisplayId", window.getDisplayId(), false);
					showToast("Selected Window: " + window.getTitle());
					TOP.displayStructure(window);
				}
				return this;
			}
			This listener = listener();
			windowMenu.setOnClickListener(listener);
		}
		if (scriptEditor == null) scriptEditor = ScriptEditor();
		if (assistSetting == null) assistSetting = AssistSetting();
		if (actionPicker == null) actionPicker = ActionPicker();
		if (actionsGroupDialog == null) actionsGroupDialog = ActionsGroupDialog();
	}

	clearResources() {
		if (filterSheet != null) filterSheet.remove();
		filterSheet = null;
		if (nodeSearch != null) nodeSearch.remove();
		nodeSearch = null;
		if (displayMenu != null) displayMenu.remove();
		displayMenu = null;
		if (windowMenu != null) windowMenu.remove();
		windowMenu = null;
		if (scriptEditor != null) scriptEditor.remove();
		scriptEditor = null;
		if (assistSetting != null) assistSetting.remove();
		assistSetting = null;
		if (actionsGroupDialog != null) actionsGroupDialog.remove();
		actionsGroupDialog = null;
	}

	/*────────────────────────────
	  HANDLE LISTENER
	────────────────────────────*/
	handleListener() {
		onLongPress() {
			assistBar.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS);
			toggleDisplayMenu();
		}
		onSingleTapConfirmed() {
			assistBar.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
			toggleStructure();
		}
		onDoubleTap() {
			if (structureOverlay != null) structureOverlay.unhideBoxes();
			return true;
		}
		onShowPress() {}
		return this;
	}

	moveHandle(int x, int y) {
		assistParams.x = x;
		assistParams.y = y;
		try {
			windowManager.updateViewLayout(assistBar, assistParams);
		} catch (e) {}
	}

	onMove(View view, MotionEvent event) {
		switch (event.getAction()) {
			case 0: // ACTION_DOWN
				int[] loc = new int[2];
				assistBar.getLocationOnScreen(loc);
				initialWinX = loc[0];
				initialWinY = loc[1];
				assistParams.x = initialWinX;
				assistParams.y = initialWinY;
				initialTouchX = event.getRawX();
				initialTouchY = event.getRawY();
				return false;
			case 2: // ACTION_MOVE
				int x = initialWinX + (int)(event.getRawX() - initialTouchX);
				int y = initialWinY + (int)(event.getRawY() - initialTouchY);
				moveHandle(x, y);
				return false;
		}
		return false;
	}

	addListenerAndGesture() {
		MaterialButton handle = getButton(AssistInfo.HANDLE_BUTTON);
		if (handle != null) {
			handleGesture = SimpleGesture(handle, handleListener());
			handle.setOnTouchListener(new View.OnTouchListener() {
				onTouch(View view, MotionEvent event) {
					detector.onTouchEvent(event);
					onMove(view, event);
					return false;
				}
			});
		}

		assistBar.setOnTouchListener(new View.OnTouchListener() {
			onTouch(View view, MotionEvent event) {
				onMove(view, event);
				return false;
			}
		});

		assistBar.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
			onViewAttachedToWindow(View v) {
				try {
					hasShownOnce = true;
					isShowing = true;
					if (isRemoved) isRemoved = false;
					refreshSize();
					setupResources();
				} catch (e) {
					log(e.getMessage(), "ERROR", TOP, true);
				}

			}
			onViewDetachedFromWindow(View v) {
				// try {
				isShowing = false;
				isRemoved = true;
				clearResources();
				a11Y.clean();
				// } catch (e) {
				// 	log(e.getMessage(), "ERROR", TOP, true);
				// }
			}
		});
	}

	isAdded() {
		if (assistBar == null) return false;
		return assistBar.getParent() != null && assistBar.isAttachedToWindow();
	}

	isHidden() {
		if (assistBar == null) return false;
		return assistBar.getVisibility() == View.GONE && isAdded();
	}

	isShowing() {
		if (assistBar == null) return false;
		return assistBar.getVisibility() == View.VISIBLE && isAdded();
	}

	isRemoved() {
		if (assistBar == null) return false;
		return !isAdded();
	}

	remove() {
		removeStructure();
		stuctureOverlay = null;
		if (isShowing()) windowManager.removeView(assistBar);
		isShowing = false;
		a11Y.clean();
	}

	show() {
		if (assistBar == null) {
			create();
			addButtons();
			addListenerAndGesture();
		}
		Runnable displayOverlay = new Runnable() {
			run() {
				if (detector == null && handleGesture != null) {
					detector = handleGesture.getDetector();
				}
				windowManager.addView(assistBar, assistParams);
			}
		};
		if (!isShowing()) mainHandler.post(displayOverlay);
	}

	return this;
}

public This AssistBar(float x, float y) {
	DisplayMetrics metrics = context.getResources().getDisplayMetrics();
	int width = metrics.widthPixels;
	int height = metrics.heightPixels;
	int finalX = (x >=0f && x <=1f) ? (int)(x * width) : (int) x;
	int finalY = (y >=0f && y <=1f) ? (int)(y * height) : (int) y;
	return AssistBar(finalX, finalY);
}

public This AssistBar(double x, double y) {
	return AssistBar((float) x, (float) y);
}