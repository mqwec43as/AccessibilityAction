importCommands("others");
importCommands("others.screenshot");

import bsh.This;
import android.view.accessibility.AccessibilityNodeInfo;
import android.graphics.Point;
import android.os.Looper;

/*───────────────────────────────────────────────────────────────
	Display Menu
  ───────────────────────────────────────────────────────────────*/
DisplayMenu(This assistBar) {
	final This TOP = this;
	This a11Y = getA11yInstance();
	This ScreenshotHelper = ScreenshotHelper();
	final int WINDOW_TYPE = ENV.Layout.TYPE_DISPLAY_MENU;
	a11Y.viewControl.addView(TOP);
	List displayList = new ArrayList();
	This displayInfos;
	This config;
	This listDialog;
	This onClickListener;
	List screenshots = new ArrayList();
	long screenshotDelay = a11Y.screenshotDelay != void ? a11Y.screenshotDelay : 500;

	loadList() {
		displayList.clear();
		Display[] displays = displayInfos.displays;
		for (int i = 0; i < displays.length; i++) {
			Display display = displays[i];
			Map item = new HashMap();
			item.put("title", display.getName());
			String size = display.getWidth() + "x" + display.getHeight();
			int id = display.getDisplayId();
			String description = "ID: " + id + "\nSize: " + size;

			AccessibilityNodeInfo root = getRoot(id);
			if (root != null) {
				String packageName = root.getPackageName();
				String packageLabel = a11Y.packageManager.getLabel(packageName);
				description += "\nPackage: " + packageName + " (" + packageLabel + ")";
			}

			item.put("subtitle", description);
			item.put("display", display);
			try {
				int index = i + 1; 
				listener() {
					onSuccess(This ss) {
						screenshots.add(ss);
						item.put("icon", ss.getDrawable());
					}
					onError(int errorCode) {
						String message = ScreenshotHelper.getErrorMessage(errorCode);
						log(message, "ERROR", TOP);
						tasker.showToast(message, "Display: " + display.getName() + " (" + id + ")");
					}
					return this;
				}
				This ss = takeScreenshot(id, listener());
				Thread.sleep(screenshotDelay);
			} catch(e) {
				tasker.showToast(e.toString());
				log(e.getMessage(), "ERROR", TOP);
			}
			displayList.add(item);
		}
	}


	config(This THIS) {
		List itemList = TOP.displayList;
		String title = "Display Menu";
		String text = "Tap: Capture tree, Long tap: Move assist bar";
		int iconSize = 240;
		boolean showFilter;
		int displayId = assistBar.getContext().getDisplay().getDisplayId();

		boolean useOverlay = !assistBar.shouldUseActivity();
		boolean useAccessibility = true;
		float dimAmount = 0.5f;
		float maxWidth = 0.5f;

		onSuccess(Map map) {
			Display display = map.get("display");
			boolean longClick = map.getOrDefault("longClick", false);
			if (TOP.onClickListener != null) {
				Runnable runMe = new Runnable() {
					run() {
						try {
							if (longClick) {
								assistBar.show(display.getDisplayId());
							} else {
								if (TOP.namespace.getVariable("onClickListener") != null) {
									TOP.onClickListener.onClick(display);
								} else {
									log("No onClickListener set", "INFO", TOP);
									showToast("No onClickListener set");
								}
							}
						} catch (Exception e) {
							log(e.getMessage(), "ERROR", TOP);
							showToast(e.getMessage());
						}
					};
				};
				a11Y.postDelayed(runMe, 500);
			} else {
				log("No onClickListener set", "ERROR", TOP);
			}
			TOP.remove();
		}

		onCancel() {

		}

		onTimeout() {}

		onAttach() {}

		onDetach() {
			for (This ss: screenshots) {
				try {
					ss.recycle();
				} catch (e) {
					log(e.getMessage(), "ERROR", TOP);
				}
			}
		}

		return this;
	}

	setOnClickListener(This listener) {
		TOP.onClickListener = listener;
	}

	create(boolean readDisplay) {
		if (readDisplay) {
			displayInfos = DisplayInfos();
			loadList();
		}
		config = config(TOP);
		listDialog = ListDialog(config);
		bind(TOP, listDialog.namespace);
	}

	create(false);

	show() {
		create(true);
		boolean isMainThread = Looper.getMainLooper().isCurrentThread();
        if (config.useOverlay) {
            if (isMainThread) {
                listDialog.show();
            } else {
                Runnable showRun = new Runnable() {
                    run() {
                        listDialog.show();
                    }
                };
                a11Y.post(showRun);
            }
		} else {
			listDialog.show();
		}
	}


	return this;
}