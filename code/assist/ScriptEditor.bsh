/*───────────────────────────────────────────────────────────────
  dp(int val)
  **Density Converter**
  Converts pixels to density-independent pixels.
 ───────────────────────────────────────────────────────────────*/
public int dp(int val) {
	return (int)(val * context.getResources().getDisplayMetrics().density);
}

/*───────────────────────────────────────────────────────────────
  addSpacer(Context ctx, ViewGroup container)
  **Layout Spacer**
  Adds a vertical 8dp gap between views.
 ───────────────────────────────────────────────────────────────*/
public void addSpacer(Context ctx, ViewGroup container) {
	int spacerHeight = dp(8);
	View spacer = new View(ctx);
	LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, spacerHeight);
	spacer.setLayoutParams(params);
	container.addView(spacer);
}



/*───────────────────────────────────────────────────────────────
  ScriptEditor()
  **Main UI Class**
  Handles the creation and logic of the floating script editor.
 ───────────────────────────────────────────────────────────────*/
ScriptEditor() {

	if (ENV == void || ENV == null) ENV = Environment();
	ENV.checkMaterialLib(this);

	final This TOP = this;
	This a11Y = getA11yInstance();
	final int WINDOW_TYPE = ENV.Layout.TYPE_SCRIPT_EDITOR;
	a11Y.viewControl.addView(TOP);

	Activity activity;
	LinearLayout content;
	TextInputEditText editText;
	ChipGroup windowGroup;
	ChipGroup editGroup;
	ChipGroup displayGroup;
	FrameLayout baseRoot;
	This displayInfos;
	This tm;
	boolean isRemoved;
	boolean hasShown;
	boolean isActionEdit;
	String codeText;
	int selectedDisplayId = a11Y.assistBar.selectedDisplayId;
	int selectedWindowFilter = a11Y.assistBar.selectedWindowFilter;

	boolean isActionEdit() {
		return getUsageEvents() { "className" }.equals("net.dinglisch.android.taskerm.ActionEdit");
	}

	boolean isGenericAction() {
		return getUsageEvents() { "className" }.equals("com.joaomgcd.taskerm.genericaction.ActivityGenericAction");
	}

	void paste(String script, boolean append) {
		if (isGenericAction()) {
			remove();
			wait(500);
		}
		if (isActionEdit) {
			String actionId = "android:id/action_bar";
			nodes = findNodes("id", actionId);
			isJava = findNodes(toNode(nodes), "text", "Java Code");
			if (hasNode(isJava)) {
				boolean oldDebugMe = a11Y.debugMe;
				This a11Y = getA11yInstance();
				a11Y.debugMe = false;
				script = appendHeader(script);
				setText("id", "net.dinglisch.android.taskerm:id/edittext", script, 0);
				a11Y.debugMe = oldDebugMe;
				return;
			}
		}
		showToast("Not in Java code action" + getUsageEvents() { "className" });

	}

	void pasteText() {
		Runnable pasteRun = new Runnable() {
			run() {
				String script = editText.getText().toString();
				paste(script, true);
			}
		};
		a11Y.execute(pasteRun);
	}


	void copy() {
		if (codeText != null) {
			editText.setText(codeText);
			return;
		}
		showToast("Not in Java code action" + getUsageEvents() { "className" });
	}

	String getLines() {
		String fullText = editText.getText().toString();
		int start = editText.getSelectionStart();
		int end = editText.getSelectionEnd();
		int lineStart = fullText.lastIndexOf('\n', start - 1) + 1;
		int lineEnd = fullText.indexOf('\n', end);
		if (lineEnd == -1) lineEnd = fullText.length();
		return fullText.substring(lineStart, lineEnd);
	}

	boolean hasSetDisplay(String script) {
		return script.contains("setDisplay(");
	}

	boolean hasA11y(String script) {
		return script.contains("a11Y.set();");
	}

	boolean hasWindowFilter(String script) {
		String[] filterMethods = { "addWindowFilter", "setWindowFilter", "include\\w+Window", "includeAllWindows" };
		for (String method : filterMethods) {
			Pattern pattern = Pattern.compile("\\b" + method + "\\(");
			Matcher matcher = pattern.matcher(script);
			if (matcher.find()) {
				return true;
			}
		}
		return false;
	}

	String appendHeader(String script) {
		script = script.trim();
		String header = "";
		if (!hasA11y(script)) {
			header += "a11Y.set();\n";
		}
		if (!hasSetDisplay(script) && selectedDisplayId != 0) {
			header += "setDisplay(" + selectedDisplayId + ");\n";
		}

		if (!hasWindowFilter(script) && selectedWindowFilter != 0) {
			String windows = String.join(" | ", WindowInfo.getFlagStringList(selectedWindowFilter));
			header += "addWindowFilter(" + windows + ");\n";
		} else {
			tasker.showToast("No filter");
		}

		if (header.length() > 0) {
			script = header + script;
		}
		return script.trim();
	}

	String sanitize(String script) {
		script = script.trim();
		if (hasA11y(script)) {
			script = script.replace("a11Y.set();", "");
		}
		return script.trim();
	}

	void executeText() {
		Runnable runAll = new Runnable() {
			run() {
				String script = editText.getText().toString();
				remove();
				runScript(script, 100, selectedDisplayId, selectedWindowFilter);
			}
		};
		a11Y.executeA11y(runAll);
	}

	This activityListener() {
		// ! Might need to remove later if Tasker allows Activity to not be excluded in recents
		// Remove when activity is stopped
		onStopped(ActivityLifecycleEvent event) {
			event.activity.finish();
		}

		return this;
	}

	addGroupTitle(String titleName, ChipGroup group) {
		if (titleName == null || group == null) return;
		MaterialTextView textView = new MaterialTextView(activity);
		textView.setText(titleName);
		textView.setTypeface(null, 1);
		// textView.setTextSize(ENV.Settings.GROUP_TITLE_TEXT_SIZE);
		textView.setTextColor(tm.color("colorPrimary"));
		textView.setOnClickListener(new View.OnClickListener() {
			onClick(View v) {
				if (group.getVisibility() == View.VISIBLE) {
					group.setVisibility(View.GONE);
				} else {
					group.setVisibility(View.VISIBLE);
				}
			}
		});
		content.addView(textView);
	}


	Chip addChip(ChipGroup group, String text, boolean checkAble, View.OnClickListener onClickListener) {
		Chip chip = new Chip(activity);
		chip.setText(text);
		chip.setCheckable(checkAble);
		chip.setOnClickListener(onClickListener);
		group.addView(chip);
		return chip;
	}

	Chip addEditChip(String text, boolean checkAble, View.OnClickListener onClickListener) {
		return addChip(editGroup, text, checkAble, onClickListener);
	}

	Chip addDisplayChip(Display display) {
		String name = display.getName();
		View.OnClickListener onClickListener = new View.OnClickListener() {
			onClick(View view) {
				view.setChecked(true);
				selectedDisplayId = display.getDisplayId();
			}
		};
		return addChip(displayGroup, name, true, onClickListener);
	}

	addEditGroup() {
		editGroup = new ChipGroup(activity);
		int spacing = dp(-4);
		editGroup.setChipSpacingVertical(spacing);
		content.addView(editGroup);

		// { Chip text, checkable, listener}
		Object[][] editChips = new Object[][] {
			{
				"Run Line",
				false,
				new View.OnClickListener() {
					onClick(View v) {
						String code = getLines();
						remove();
						runScript(code, 100, selectedDisplayId, selectedWindowFilter);
					}
				}
			},
			{
				"Set to code",
				false,
				new View.OnClickListener() {
					onClick(View v) {
						pasteText();
					}
				}
			},
			{
				"Copy",
				false,
				new View.OnClickListener() {
					onClick(View v) {
						copy();
					}
				}
			},
			{
				"Clear",
				false,
				new View.OnClickListener() {
					onClick(View v) {
						editText.setText("");
					}
				}
			}
		};

		for (Object[] chip: editChips) {
			addEditChip(chip[0], chip[1], chip[2]);
		}
	}

	getDisplays() {
		return context.getSystemService(Context.DISPLAY_SERVICE).getDisplays();
	}

	updateDisplayGroup() {
		if (displayGroup == null) return;

		displayGroup.removeAllViews();
		Display[] displays = getDisplays();

		if (displays.length > 1) {
			for (Display display: displays) {
				addDisplayChip(display);
			}
			displayGroup.setVisibility(View.VISIBLE);
			log("Multiple displays detected", "INFO", TOP);
		} else {
			displayGroup.setVisibility(View.GONE);
			log("Single display detected", "INFO", TOP);
		}
	}

	addDisplayGroup() {
		Display[] displays = getDisplays();
		if (displayGroup == null && displays.length > 1) {
			addSpacer(activity, content);
			displayGroup = new ChipGroup(activity);
			addGroupTitle("Target Display", displayGroup);
			displayGroup.setSingleSelection(true);
			content.addView(displayGroup);
			addSpacer(activity, content);
		}
		updateDisplayGroup();
	}

	updateWindowGroup() {
		return tasker.showToast("Window Filter updated: " + selectedWindowFilter);
		for (int i = 0; i < windowGroup.getChildCount(); i++) {
			Chip chip = windowGroup.getChildAt(i);
			int flag = chip.getTag();
			boolean hasFlag = WindowInfo.hasFlag(selectedWindowFilter, flag);
			chip.setChecked(hasFlag);
		}
	}

	Chip addWindowChip(String flagName, boolean isInitialChecked, int flag) {
		Chip chip = new Chip(activity);
		chip.setText(flagName);
		chip.setCheckable(true);
		chip.setChecked(isInitialChecked);
		chip.setTag(flag);

		chip.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
			onCheckedChanged(CompoundButton buttonView, boolean isChecked) {
				if (isChecked) {
					selectedWindowFilter = selectedWindowFilter | flag;
				} else {
					selectedWindowFilter = selectedWindowFilter & ~flag;
				}
				updateWindowGroup();
			}
		});

		windowGroup.addView(chip);
		return chip;
	}

	addWindowGroup() {
		addSpacer(activity, content);
		windowGroup = new ChipGroup(activity);
		addGroupTitle("Target Window", windowGroup);
		int spacing = dp(-4);
		windowGroup.setChipSpacingVertical(spacing);
		content.addView(windowGroup);

		// { Chip text, checkable, flag}
		Object[][] editChips = new Object[][] {
			{
				"App",
				false,
				WindowInfo.TYPE_APPLICATION
			},
			{
				"Input",
				false,
				WindowInfo.TYPE_INPUT_METHOD
			},
			{
				"System",
				false,
				WindowInfo.TYPE_SYSTEM
			},
			{
				"Accessibility",
				false,
				WindowInfo.TYPE_ACCESSIBILITY_OVERLAY
			},
			{
				"Split screen divider",
				false,
				WindowInfo.TYPE_SPLIT_SCREEN_DIVIDER
			},
			{
				"Magnification",
				false,
				WindowInfo.TYPE_MAGNIFICATION_OVERLAY
			},
			{
				"Window Control",
				false,
				WindowInfo.TYPE_WINDOW_CONTROL
			}
		};

		for (Object[] chip: editChips) {
			addWindowChip(chip[0], chip[1], chip[2]);
		}
	}



	void layout(Activity activity) {
		TOP.activity = activity;
		tm = ThemeManager(activity);
		tm.setThemeDark();

		selectedDisplayId = a11Y.assistBar.selectedDisplayId;
		selectedWindowFilter = a11Y.assistBar.selectedWindowFilter;

		This monitor = SimpleActivityMonitor(activity, activityListener());
		float density = activity.getResources().getDisplayMetrics().density;
		displayInfos = DisplayInfos();
		window = activity.getWindow();
		window.requestFeature(Window.FEATURE_NO_TITLE);
		window.setBackgroundDrawableResource(android.R.color.transparent);
		window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS |
			WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS |
			WindowManager.LayoutParams.FLAG_DIM_BEHIND);

		WindowManager.LayoutParams windParams = window.getAttributes();
		windParams.gravity = Gravity.BOTTOM;
		windParams.width = WindowManager.LayoutParams.MATCH_PARENT;
		windParams.dimAmount = 0.5f;
		window.setAttributes(windParams);
		baseRoot = new FrameLayout(activity);

		/* Apply requested shape to baseRoot */
		GradientDrawable shape = new GradientDrawable();
		shape.setCornerRadius(28 * density);
		shape.setColor((int) tm.color("colorSurface"));
		baseRoot.setBackground(shape);
		baseRoot.setClipToOutline(true);

		root = new FloatingToolbarLayout(activity);
		root.setBackgroundColor(Color.TRANSPARENT);

		final LinearLayout main = new LinearLayout(activity);
		main.setOrientation(LinearLayout.VERTICAL);

		FrameLayout.LayoutParams mainParams = new FrameLayout.LayoutParams(-1, -2);
		mainParams.gravity = Gravity.BOTTOM;
		main.setLayoutParams(mainParams);

		/* Background already set on baseRoot per request */

		toolbar = new MaterialToolbar(activity);
		toolbar.setTitle("Script Editor");
		toolbar.setTitleCentered(true);
		main.addView(toolbar);

		ScrollView scroller = new ScrollView(activity);
		scroller.setVerticalScrollBarEnabled(false);

		content = new LinearLayout(activity);
		content.setOrientation(LinearLayout.VERTICAL);
		int p = (int)(20 * density);
		// 		content.setPadding(p, p, p, p);
		scroller.addView(content);

		main.addView(scroller, new LinearLayout.LayoutParams(-1, 0, 1.0f));

		TextInputLayout inputLayout = new TextInputLayout(activity);

		editText = new TextInputEditText(inputLayout.getContext());
		String initialText = "";
		String startText = (a11Y.scriptEditor != void && a11Y.scriptEditor != null) ? a11Y.scriptEditor : initialText;

		editText.setText(startText);
		editText.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
		editText.setMaxLines(15);

		editText.addTextChangedListener(new TextWatcher() {
			beforeTextChanged(CharSequence s, int start, int count, int after) {}
			onTextChanged(CharSequence s, int start, int before, int count) {
				This a11Y = getA11yInstance();
				a11Y.namespace.setVariable("scriptEditor", s.toString(), false);
			}
			afterTextChanged(Editable s) {}
		});

		inputLayout.addView(editText);
		content.addView(inputLayout);
		addSpacer(activity, content);

		addEditGroup();
		addWindowGroup();
		addDisplayGroup();

		MaterialButton runAllBtn = new MaterialButton(activity);
		runAllBtn.setText("RUN ALL");
		runAllBtn.setOnClickListener(new View.OnClickListener() {
			onClick(View v) {
				executeText();
			}
		});
		content.addView(runAllBtn);

		root.addView(main);
		baseRoot.addView(root);
		activity.setContentView(baseRoot);

		activity.getWindow().getDecorView().addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
			onViewAttachedToWindow(View v) {
				isRemoved = false;
				hasShown = true;
			}
			onViewDetachedFromWindow(View v) {
				isRemoved = true;
				hasShown = false;
				activity.finish();
			}
		});

	}

	java.util.function.Consumer uiLogic = new java.util.function.Consumer() {
		accept(Object activityObj) {
			layout((Activity) activityObj);
		}
	};

	void show() {
		codeText = null;
		isActionEdit = isActionEdit();
		boolean oldDebugMe = debugMe;
		debugMe = false;
		List actionNodes = findNodes("id", "android:id/action_bar");
		if (hasNode(actionNodes)) {
			List isJava;
			isJava = findNodes(toNode(actionNodes), "text", "Java Code");
			if (hasNode(isJava)) {
				List edits = findNodes("id", "net.dinglisch.android.taskerm:id/edittext");
				if (!hasNode(edits)) return;
				codeText = getText(edits);
				codeText = codeText.trim();
				codeText = sanitize(codeText);
			}
		}
		debugMe = oldDebugMe;
		if (!isShowing()) {
			isRemoved = false;
			hasShown = true;
			tasker.doWithActivity(uiLogic);
		}
	}

	void remove() {
		if (activity != null) {
			activity.finish();
		}
		isRemoved = true;
	}

	void toggle() {
		if (!isShowing()) {
			show();
		} else {
			remove();
		}
	}

	boolean isAdded() {
		if (baseRoot == null) return false;
		return baseRoot.getParent() != null && baseRoot.isAttachedToWindow();
	}

	boolean isHidden() {
		if (baseRoot == null) return false;
		return baseRoot.getVisibility() == View.GONE && isAdded();
	}

	boolean isShowing() {
		if (baseRoot == null) return false;
		return baseRoot.getVisibility() == View.VISIBLE && isAdded();
	}

	boolean isRemoved() {
		if (baseRoot == null) return false;
		return !isAdded();
	}

	return this;
}

