importCommands("assist.structure");

import bsh.This;
import android.view.accessibility.AccessibilityNodeInfo;
import android.graphics.Point;
import java.util.concurrent.Callable;

/*───────────────────────────────────────────────────────────────
  NodeSearch()
  ───────────────────────────────────────────────────────────────*/
NodeSearch(This structureOverlay) {
    
    final This TOP = this;
    This a11Y = getA11yInstance();
    final int WINDOW_TYPE = ENV.Layout.TYPE_NODE_SEARCH;
    a11Y.viewControl.addView(TOP);
    Map map = structureOverlay.map;
    List itemList = new ArrayList();
    int iconSize = dp(48);

	config(This THIS) {
        List itemList = TOP.itemList;
		String title = "Nodes";
		boolean showFilter = true;
        boolean useOverlay = false;
	    boolean useAccessibility = true;
		
        onSuccess(Map map) {
            This nodeBox = map.get("nodeBox");
            boolean longClick = map.getOrDefault("longClick", false);
            if (longClick) {
                Thread.sleep(200);
                structureOverlay.openActionPicker(nodeBox);
            } else {
                structureOverlay.unhide();
                Thread.sleep(200);
                structureOverlay.activeHighlight(nodeBox);
            }
		}

		onCancel() {
            structureOverlay.unhide();
        }

		onTimeout() {
            structureOverlay.unhide();
        }

        onAttach() {
            structureOverlay.hide();
        }

        onDetach() {
            structureOverlay.unhide();
        }
        
		return this;
	}

    This config = config(this);
    This listDialog = ListDialog(config);
    
    // * Make listDialog methods available here.
    bind(this, listDialog.namespace);

    loadList() {
        boolean includeEmpty = a11Y.includeEmptyNodeinSearch;
        for (AccessibilityNodeInfo node: map.keySet()) {
			This nodeBox = map.get(node);
            if (nodeBox.isHidden()) continue;
            String id = node.viewIdResourceName;
            String text = getText(node);
            boolean empty = id == null && (text == null || text.isEmpty());
            if (empty && !includeEmpty) continue;

            // Add title
			Map item = new HashMap();
			item.put("title", id != null ? id : "[No id]");
            
            // Add contents
            List contents = new ArrayList();
            contents.add("Class: " + node.className);
            if (text != null && !text.isEmpty()) contents.add("Text: " + text);
            Point coor = getCoordinates(node);
            contents.add("Coor: " + coor.x + "," + coor.y);
            contents.add("Depth: " + nodeBox.depth);
            String content = String.join("\n", contents);
			item.put("subtitle", content);
            Callable getIcon = new Callable() {
                call() {
                   return structureOverlay.structureSnapshot.getNodeBoxDrawable(nodeBox);
                }
            };
            item.put("getIcon", getIcon);
            // Attach nodeBox
            item.put("nodeBox", nodeBox);

			itemList.add(item);
		}
    }

    loadList();
	return this;
}

/* Auto-start if called directly */
