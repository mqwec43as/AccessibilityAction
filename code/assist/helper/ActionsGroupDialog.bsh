import bsh.This;

ActionsGroupDialog(This assistBar) {
	final This TOP = this;
	final This a11Y = getA11yInstance();
	final int WINDOW_TYPE = ENV.Layout.TYPE_ACTIONS_GROUP_DIALOGS;
	a11Y.viewControl.addView(TOP);

	This listDialog;
	This dialogConfig;

	if (a11Y.assistBar == void) {
		showToast("AssistBar not found");
		return;
	}
	
	This actionPicker = ActionPicker(assistBar);
	This displayMenu = a11Y.assistBar.displayMenu;
	This windowMenu = a11Y.assistBar.windowMenu;
	
	Runnable displayMenuRun = new Runnable() {
		run() {
			a11Y.viewControl.show(ENV.Layout.TYPE_DISPLAY_MENU);
		}
	};

	Runnable gestureRun = new Runnable() {
		run() {
			actionPicker.selectGesture();
		}
	};

	Runnable globalOthersRun = new Runnable() {
		run() {
			actionPicker.selectGlobalOthers();
		}
	};

	Runnable utilsDialogRun = new Runnable() {
		run() {
			actionPicker.selectUtils();
		}
	};

	Runnable allMethodsRun = new Runnable() {
		run() {
			actionPicker.selectAll();
		}
	};

	Runnable windowMenuRun = new Runnable() {
		run() {
			windowMenu.show();
		}
	};

	// title, description, Runnable, Main THread
	Object[][] Groups = new Object[][] {
		{
			"Display",
			"Select display and capture structure",
			displayMenuRun,
			false
		},
		{
			"Window",
			"Select window and capture structure",
			windowMenuRun,
			false
		},
		{
			"Gestures",
			"Pick gestures such as long press and tap",
			gestureRun,
			false
		},
		{
			"Global & Others",
			"Pick global and other actions.",
			globalOthersRun,
			false
		},
		{
			"Utils",
			"Pick utils methods to inspect nodes.",
			utilsDialogRun,
			false
		},
		{
			"All methods",
			"All methods of this project",
			allMethodsRun,
			false
		}
	};


	dialog(This THIS) {
		String title = "Select Action";
		boolean showFilter = true;
		boolean showFilter;
		List itemList = new ArrayList();
		int displayId = assistBar.getContext().getDisplay().getDisplayId();
		float dimAmount = 0.5f;

		boolean useOverlay = !assistBar.shouldUseActivity();
		boolean useAccessibility = true;

		for (int i = 0; i < Groups.length; i++) {
			Map map = new HashMap();
			map.put("title", Groups[i][0]);
			map.put("subtitle", Groups[i][1]);
			map.put("run", Groups[i][2]);
			map.put("useMain", Groups[i][3]);
			itemList.add(map);
		}

		onSuccess(Map map) {
			boolean useMain = map.get("useMain");
			Runnable runMe = map.get("run");
			if (useMain) {
				a11Y.post(runMe);
				return;
			} else {
				a11Y.execute(runMe);
			}
		}

		onAttach() {
			a11Y.addOverlay(listDialog);
		}

		onCreated() {
			a11Y.addOverlay(listDialog);
		}

		onCancel() {}

		onTimeout() {}
		return this;
	}

	create() {
		if (dialogConfig == null) dialogConfig = dialog(TOP);
		listDialog = ListDialog(dialogConfig);

		// * Make listDialog methods available here.
		bind(TOP, listDialog.namespace);
	}

	create();

	show() {
		boolean useOverlay = !assistBar.shouldUseActivity();
		if (useOverlay != dialogConfig.useOverlay) {
			dialogConfig.useOverlay = useOverlay;
			create();
		}
		listDialog.show();
	}

	return this;
}