public boolean gestureShizuku(Object[][] points, Paint paint) {
    if (points == null || points.length == 0) return false;

    ShizukuBinderWrapper inputBinder = tasker.getShizukuService("input");
    IInputManager$Stub$Proxy inputManagerProxy = IInputManager$Stub.asInterface(inputBinder);
    Context windowContext = getContext(true);
    WindowManager windowManager = (WindowManager) windowContext.getSystemService(Context.WINDOW_SERVICE);
    int targetDisplayId = windowContext.getDisplay().getDisplayId();
    DisplayMetrics displayMetrics = getDisplayMetrics(targetDisplayId);
    int screenWidth = displayMetrics.widthPixels;
    int screenHeight = displayMetrics.heightPixels;

    boolean showTrail = (paint != null);
    Bitmap trailBitmap = null;
    Canvas trailCanvas = null;
    ImageView overlayImageView = null;
    if (showTrail) {
        trailBitmap = Bitmap.createBitmap(screenWidth, screenHeight, Bitmap.Config.ARGB_8888);
        trailCanvas = new Canvas(trailBitmap);
        overlayImageView = new ImageView(context);
        overlayImageView.setImageBitmap(trailBitmap);

        WindowManager.LayoutParams windowParams = new WindowManager.LayoutParams(
            WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
            PixelFormat.TRANSLUCENT
        );
        windowParams.gravity = Gravity.TOP | Gravity.LEFT;

        final ImageView finalOverlayImageView = overlayImageView;
        final WindowManager.LayoutParams finalWindowParams = windowParams;
        new Handler(Looper.getMainLooper()).post(new Runnable() {
            run() { try { windowManager.addView(finalOverlayImageView, finalWindowParams); } catch (Exception ignoredException) {} }
        });
    }

    try {
        long downTime = SystemClock.uptimeMillis();
        float lastX = 0f;
        float lastY = 0f;

        for (int pointIndex = 0; pointIndex < points.length; pointIndex++) {
            float targetX = points[pointIndex][0];
            float targetY = points[pointIndex][1];
            if (Math.abs(targetX) <= 1.0f) targetX *= screenWidth;
            if (Math.abs(targetY) <= 1.0f) targetY *= screenHeight;

            int actionType = points[pointIndex][2].intValue();
            long stepDuration = points[pointIndex][3].longValue();

            if (actionType == 3 && points[pointIndex].length >= 6) {
                float controlX1 = points[pointIndex][4];
                float controlY1 = points[pointIndex][5];
                if (Math.abs(controlX1) <= 1.0f) {
                    controlX1 *= screenWidth;
                    controlY1 *= screenHeight;
                }

                int totalSteps = (int) Math.max(1, stepDuration / 16);
                long subStepDuration = stepDuration / totalSteps;

                for (int stepIndex = 1; stepIndex <= totalSteps; stepIndex++) {
                    float progressRatio = (float) stepIndex / totalSteps;
                    float inverseProgress = 1.0f - progressRatio;
                    float currentStepX = inverseProgress * inverseProgress * lastX + 2 * inverseProgress * progressRatio * controlX1 + progressRatio * progressRatio * targetX;
                    float currentStepY = inverseProgress * inverseProgress * lastY + 2 * inverseProgress * progressRatio * controlY1 + progressRatio * progressRatio * targetY;

                    MotionEvent motionEvent = MotionEvent.obtain(downTime, SystemClock.uptimeMillis(), MotionEvent.ACTION_MOVE, currentStepX, currentStepY, 1.0f, 1.0f, 0, 1.0f, 1.0f, 0, 0);
                    motionEvent.setSource(InputDevice.SOURCE_TOUCHSCREEN);
                    motionEvent.setDisplayId(targetDisplayId);
                    inputManagerProxy.injectInputEvent(motionEvent, 1);
                    motionEvent.recycle();

                    if (showTrail) {
                        trailCanvas.drawLine(lastX, lastY, currentStepX, currentStepY, paint);
                        final ImageView finalOverlayImageView = overlayImageView;
                        new Handler(Looper.getMainLooper()).post(new Runnable() { run() { finalOverlayImageView.invalidate(); } });
                    }

                    lastX = currentStepX;
                    lastY = currentStepY;
                    if (subStepDuration > 0) Thread.sleep(subStepDuration);
                }
            } else {
                int motionAction = (actionType == 0) ? MotionEvent.ACTION_DOWN :
                    (actionType == 1) ? MotionEvent.ACTION_UP : MotionEvent.ACTION_MOVE;

                MotionEvent motionEvent = MotionEvent.obtain(downTime, SystemClock.uptimeMillis(), motionAction, targetX, targetY, 1.0f, 1.0f, 0, 1.0f, 1.0f, 0, 0);
                motionEvent.setSource(InputDevice.SOURCE_TOUCHSCREEN);
                motionEvent.setDisplayId(targetDisplayId);
                inputManagerProxy.injectInputEvent(motionEvent, 1);
                motionEvent.recycle();

                if (showTrail) {
                    trailCanvas.drawLine(lastX, lastY, targetX, targetY, paint);
                    final ImageView finalOverlayImageView = overlayImageView;
                    new Handler(Looper.getMainLooper()).post(new Runnable() { run() { finalOverlayImageView.invalidate(); } });
                }

                lastX = targetX;
                lastY = targetY;
                if (stepDuration > 0) Thread.sleep(stepDuration);
            }
        }

        if (showTrail) {
            final ImageView finalOverlayImageView = overlayImageView;
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                run() { try { windowManager.removeView(finalOverlayImageView); } catch (Exception ignoredException) {} }
            }, 500);
        }
        return true;
    } catch (Exception executionException) {
        log("gestureShizuku Error: " + executionException.toString());
        return false;
    }
}

/* Overloaded method */
public boolean gestureShizuku(Object[][] points) {
    return gestureShizuku(points, null);
}

