import android.content.Context;
import android.graphics.Color;
import android.graphics.PixelFormat;
import android.graphics.drawable.GradientDrawable;
import android.os.Handler;
import android.os.Looper;
import android.view.Gravity;
import android.view.MotionEvent;
import android.view.View;
import android.view.ViewGroup;
import android.view.WindowManager;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.RelativeLayout;
import android.widget.ScrollView;
import com.google.android.material.appbar.MaterialToolbar;
import com.google.android.material.floatingtoolbar.FloatingToolbarLayout;
import bsh.This;
import java.util.List;
import android.util.DisplayMetrics;

/*───────────────────────────────────────────────────────────────
  FloatingSheet()
  **Accessibility Overlay FloatingSheet with Draggable Handle**

  Creates a draggable bottom sheet displayed as an accessibility overlay.
  Supports custom views and vertical dragging via visual pill handle.

  ─────────────────────────────────────────────────────────────── */

FloatingSheet(This config) {
	
	boolean hasMethod(String methodName, Class[] classes) {
		if (classes == null) classes = new Class[] {};
		return config.namespace.getMethod(methodName, classes) != null;
	}

	boolean hasAttach = hasMethod("onAttach", null);
	boolean hasDetach = hasMethod("onDetach", null);
	boolean hasGetView = hasMethod("getView", new Class[] { Object.class });
	if (!hasGetView) hasGetView = hasMethod("getView", new Class[] { Context.class });
	boolean hasGetViewList = hasMethod("getViewList", new Class[] { Object.class });
	if (!hasGetViewList) hasGetViewList = hasMethod("getViewList", new Class[] { Context.class });
	int displayId = config.displayId != void ? config.displayId : 0;
	float maxWidth = config.maxWidth == void ? 0.5f : config.maxWidth;

	if (!hasGetView && !hasGetViewList) {
		throw new Exception("No view found");
	}


	This a11Y = getA11yInstance();
	final This TOP = this;

	if (ENV == void || ENV == null) ENV = Environment();
	ENV.checkMaterialLib(this);

	Context ctx = getContext(true, displayId);
	This tm = ThemeManager(ctx);
	tm.setThemeDark();
	Object a11yService = getService();
	WindowManager windowManager = (WindowManager) ctx.getSystemService(Context.WINDOW_SERVICE);
	FrameLayout root;
	WindowManager.LayoutParams rootParams;
	FloatingToolbarLayout floatingRoot;
	LinearLayout main;
	RelativeLayout dragHandle;
	View visualPill;
	int maxHeightPx = 0;

	/*───────────────────────────────────────────────────────────────
	addSpacer(Context ctx, ViewGroup container)
	───────────────────────────────────────────────────────────────*/
	public void addSpacer(Context ctx, ViewGroup container) {
		int spacerHeight = tm.dp(8);
		View spacer = new View(ctx);
		LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, spacerHeight);
		spacer.setLayoutParams(params);
		container.addView(spacer);
	}

	/* Drag constants */
	final int DRAG_HANDLE_HEIGHT = tm.dp(30);
	final int PILL_WIDTH = tm.dp(60);
	final int PILL_HEIGHT = tm.dp(5);
	final int PILL_COLOR = 0xFFB0B0B0;

	/* Drag tracking */
	float initialTouchY;
	float initialTouchX;
	int initialWinY;
	int initialWinX;
	boolean firstShown = true;

	attachStateListener() {
		View.OnAttachStateChangeListener stateListener = new View.OnAttachStateChangeListener() {
			onViewAttachedToWindow(View v) {
				Runnable updateHeight = new Runnable() {
					run() {
						int screenHeight = ctx.getResources().getDisplayMetrics().heightPixels;
						int sheetHeight = root.getHeight();
						if (sheetHeight > maxHeightPx) {
							sheetHeight = maxHeightPx;
							rootParams.height = maxHeightPx;
						}
						rootParams.y = screenHeight - sheetHeight;
						windowManager.updateViewLayout(root, rootParams);
						root.setVisibility(View.VISIBLE);
						firstShown = false;
					}
				};
				if (firstShown) a11Y.postDelayed(updateHeight, 50);
				a11Y.addOverlay(TOP);
				if (hasAttach) config.onAttach();
			}
			onViewDetachedFromWindow(View v) {
				remove();
				if (hasDetach) config.onDetach();
			}
		};
		root.addOnAttachStateChangeListener(stateListener);
	}

	remove() {
		if (root != null && windowManager != null && !isRemoved()) {
			try {
				windowManager.removeView(root);
			} catch (Throwable e) {}
		}
	}

	layout() {
		float density = ctx.getResources().getDisplayMetrics().density;

		if (ENV == void || ENV == null) ENV = Environment();
		root = new FrameLayout(ctx);
		root.setVisibility(View.INVISIBLE);

		/* Applying requested shape to root */
		GradientDrawable shape = new GradientDrawable();
		shape.setCornerRadius(28 * density);
		shape.setColor((int) tm.color("colorSurfaceContainer"));
		root.setBackground(shape);
		root.setClipToOutline(true);

		floatingRoot = new FloatingToolbarLayout(ctx);
		floatingRoot.setBackgroundColor(Color.TRANSPARENT);

		main = new LinearLayout(ctx);
		main.setOrientation(LinearLayout.VERTICAL);

		FrameLayout.LayoutParams mainParams = new FrameLayout.LayoutParams(
			ViewGroup.LayoutParams.MATCH_PARENT,
			ViewGroup.LayoutParams.WRAP_CONTENT
		);
		mainParams.gravity = Gravity.BOTTOM;
		main.setLayoutParams(mainParams);

		/* ─────────────────────────────────────────────────────────
		   DRAG HANDLE WITH VISUAL PILL
		   ───────────────────────────────────────────────────────── */
		dragHandle = new RelativeLayout(ctx);
		dragHandle.setLayoutParams(new LinearLayout.LayoutParams(
			ViewGroup.LayoutParams.MATCH_PARENT,
			DRAG_HANDLE_HEIGHT
		));

		visualPill = new View(ctx);
		RelativeLayout.LayoutParams pillParams = new RelativeLayout.LayoutParams(PILL_WIDTH, PILL_HEIGHT);
		pillParams.addRule(RelativeLayout.CENTER_IN_PARENT);
		visualPill.setLayoutParams(pillParams);

		GradientDrawable pillBg = new GradientDrawable();
		pillBg.setColor(PILL_COLOR);
		pillBg.setCornerRadius(PILL_HEIGHT / 2);
		visualPill.setBackground(pillBg);
		dragHandle.addView(visualPill);
		main.addView(dragHandle);

		MaterialToolbar toolbar = new MaterialToolbar(ctx);
		if (config.title != void) {
			toolbar.setTitle(config.title);
			toolbar.setTitleCentered(true);
			main.addView(toolbar);
		}

		float maxHeight = config.maxHeight == void ? 0.75f: config.maxHeight;
		if (config.maxHeight != void) {
			try {
				Object v = config.maxHeight;
				if (v instanceof Number) {
					maxHeight = ((Number) v).floatValue();
				} else if (v instanceof String) {
					maxHeight = Float.parseFloat((String) v);
				}
			} catch (Throwable e) {}
		}
		if (maxHeight <=0f) maxHeight = 0.1f;
		if (maxHeight > 0.95f) maxHeight = 0.95f;

		int screenHeight = ctx.getResources().getDisplayMetrics().heightPixels;
		maxHeightPx = (int)(screenHeight * maxHeight);

		ScrollView scroller = new ScrollView(ctx);
		scroller.setVerticalScrollBarEnabled(false);

		LinearLayout content = new LinearLayout(ctx);
		content.setOrientation(LinearLayout.VERTICAL);
		scroller.addView(content);
		main.addView(scroller);


		if (hasGetView) {
			View view = config.getView(ctx);
			content.addView(view);
		} else if (hasGetViewList) {
			List views = config.getViewList(ctx);
			for (int i = 0; i < views.size(); i++) {
				View view = (View) views.get(i);
				if (i > 0) {
					addSpacer(ctx, content);
				}
				content.addView(view);
			}
		}

		floatingRoot.addView(main);
		root.addView(floatingRoot);
		attachStateListener();

		/* ─────────────────────────────────────────────────────────
		   DRAG HANDLING & VERTICAL MOVEMENT
		   ───────────────────────────────────────────────────────── */
		dragHandle.setOnTouchListener(new View.OnTouchListener() {
			onTouch(View v, MotionEvent event) {
				switch (event.getAction()) {
					case MotionEvent.ACTION_DOWN: 
						initialTouchY = event.getRawY();
						initialTouchX = event.getRawX();
						initialWinY = rootParams != null ? rootParams.y : 0;
						initialWinX = rootParams != null ? rootParams.x / 2 : 0;
						return true;
					case MotionEvent.ACTION_MOVE: 
						float deltaY = event.getRawY() - initialTouchY;
						float deltaX = event.getRawX() - initialTouchX;
						int newY = initialWinY + (int) deltaY;
						int newX = initialWinX + (int) deltaX;

						if (rootParams != null) {
							rootParams.y = newY;
							rootParams.x = newX;
							try {
								windowManager.updateViewLayout(root, rootParams);
							} catch (Throwable e) {}
						}
						return true;
				}
				return false;
			}
		});

		/* ─────────────────────────────────────────────────────────
		   CLICK OUTSIDE TO DESTROY
		   ───────────────────────────────────────────────────────── */
		root.setOnTouchListener(new View.OnTouchListener() {
			onTouch(View v, MotionEvent event) {
				if (event.getAction() != 0) return false; /* Only handle ACTION_DOWN */

				/* Get floatingRoot (sheet) bounds */
				int[] rootLoc = new int[2];
				floatingRoot.getLocationOnScreen(rootLoc);
				int rootLeft = rootLoc[0];
				int rootTop = rootLoc[1];
				int rootRight = rootLeft + floatingRoot.getWidth();
				int rootBottom = rootTop + floatingRoot.getHeight();

				float touchX = event.getRawX();
				float touchY = event.getRawY();

				/* Close only if click is outside the sheet */
				if (touchX < rootLeft || touchX > rootRight || touchY < rootTop || touchY > rootBottom) {
					remove();
					return true;
				}
				return false;
			}
		});
	}

	show() {
		if (!isShowing()) {
			if (root == null) {
				layout();
				DisplayMetrics metrics = ctx.getResources().getDisplayMetrics();
				int screenW = metrics.widthPixels;
				int screenH = metrics.heightPixels;
				int sheetWidth = WindowManager.LayoutParams.MATCH_PARENT;

				if (screenW > screenH) {
					sheetWidth = (int) (screenW * maxWidth);
					if (sheetWidth > screenW) {
						sheetWidth = WindowManager.LayoutParams.MATCH_PARENT;
					}
				}

				rootParams = new WindowManager.LayoutParams();
				rootParams.type = WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY;
				rootParams.format = PixelFormat.TRANSLUCENT;
				rootParams.flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN;
				rootParams.width = sheetWidth;
				rootParams.height = WindowManager.LayoutParams.WRAP_CONTENT;
				rootParams.gravity = Gravity.TOP;
				rootParams.y = 0;
			}

			Runnable showRun = new Runnable() {
				run() {
					try {
						windowManager.addView(root, rootParams);
					} catch (Throwable e) {
						tasker.showToast("Error adding overlay: " + e.getMessage());
					}
				}
			};
			a11Y.post(showRun);
		}
	}

	toggle() {
		if (!isShowing()) {
			show();
		} else {
			remove();
		}
	}

	isAdded() {
		if (root == null) return false;
		return root.isAttachedToWindow();
	}

	isHidden() {
		if (root == null) return false;
		return root.getVisibility() == View.GONE && isAdded();
	}

	isShowing() {
		if (root == null) return false;
		return root.getVisibility() == View.VISIBLE && isAdded();
	}

	isRemoved() {
		if (root == null) return false;
		return !isAdded();
	}

	return this;



}
