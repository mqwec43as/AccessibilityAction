import android.view.accessibility.AccessibilityNodeInfo;
import bsh.This;
/*───────────────────────────────────────────────────────────────
 * scrollForward(String key, String value, int index)
 * **Scroll Forward**
 * Scrolls the scrollable container **forward** (e.g., down/right).
 * If no parameters, scrolls the first scrollable container on the screen.
 *
 * Arguments:
 * * - key → Target node selector type.
 * * - value → Target node identifier.
 * * - index → Node index (0 for first match).
 *
 * Example (Screen-wide):
 * scrollForward();
 * ───────────────────────────────────────────────────────────────*/
scrollForward(AccessibilityNodeInfo node) {
	if (node == null) return null;
	if (!node.isScrollable()) node = getScrollableParent(node);
	boolean success;
	if (node != null) success = node.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD);
	if (success) {
        node.refresh();
        stepDelay();
	    return node;
    } else {
        return null;
    }
}

scrollForward(This multiKeys) {
	return scrollForward(getNode(multiKeys));
}

scrollForward(String key, String value, int index) {
	AccessibilityNodeInfo node = getNode(key, value, index);
	return scrollForward(node);
}

scrollForward(int scrollCount, int areaOrderIndex) {
	List scrollableNodes = findScrollNodes();
    
	if (!hasNode(scrollableNodes)) {
		log("No scrollable node found on screen.");
		return null;
	} else {
        AccessibilityNodeInfo node = toNode(scrollableNodes, areaOrderIndex);
        boolean hasSuccess;

        for (int i = 0; i < scrollCount; i++) {
            node.refresh();
            boolean success = node.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD);
            if (!success) {
                log("Failed to scroll forward at." + i + "th of " + scrollCount + " times.");
                break;
            } else {
                if (A11yConfig.stepDelay <= 50) {
					wait(50);
				} else {
					stepDelay();
				}
            }
        }

        if (hasSuccess) {
            return node;
        } else {
            return null;
        }
    }
}

scrollForward(int scrollCount) {
    return scrollForward(scrollCount, 0);
}

scrollForward() {
    return scrollForward(1,0);
}
